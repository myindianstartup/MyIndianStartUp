REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
REACT_APP_API_URL=http://localhost:5000
REACT_APP_SITE_URL=http://localhost:3000
REACT_APP_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# Production note:
# If frontend and backend are deployed together with the root vercel.json,
# REACT_APP_API_URL can be omitted in Vercel and the app will use the same origin.
# REACT_APP_SUPABASE_URL must be the project base URL only.
# Correct: https://your-project-ref.supabase.co
# Wrong: https://your-project-ref.supabase.co/rest/v1
